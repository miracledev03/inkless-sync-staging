# Production — Render service "Inkless HubSpot Boulevard Sync" (deploys from `production` branch)
# Set these as Render environment variables. For local production scripts, copy to
# .env.production (gitignored) and run with:  $env:ENV_FILE='.env.production'

# HubSpot production portal (private app / service key)
HUBSPOT_PORTAL_ID=
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CLIENT_SECRET=

# Boulevard production business (prod | production | live all select dashboard.boulevard.io)
BLVD_ENV=production
BLVD_BUSINESS_ID=
# Boulevard v2026-06 app (Developer Portal > Manage Apps > OAuth Credentials).
# Production always uses oauth; the secret is the Base64 text exactly as shown in the portal.
BLVD_AUTH_MODE=oauth
BLVD_CLIENT_ID=
BLVD_CLIENT_SECRET=
# BLVD_API_VERSION=2026-06
# BLVD_WEBHOOK_MAX_AGE_SEC=300

# Public URLs (Render production host)
PORT=3456
BLVD_WEBHOOK_PATH=/webhooks/boulevard
WEBHOOK_PUBLIC_URL=https://<production-host>/webhooks/boulevard
HUBSPOT_WEBHOOK_PATH=/webhooks/hubspot
HUBSPOT_WEBHOOK_PUBLIC_URL=https://<production-host>/webhooks/hubspot

# Ops endpoints (/backfill-clients, /create-client, /sync-*, /book-consult, /integration-review)
# require header  x-admin-token: <value>  or  Authorization: Bearer <value>.
# Empty in production = those endpoints return 403.
ADMIN_API_TOKEN=

# Per-environment config files (these are the production defaults; listed for clarity)
HUBSPOT_ID_MAP_PATH=./config/hubspot-ids.production.json
SERVICE_MAP_PATH=./config/service-map.production.json

# Pollers stay OFF in production (default when BLVD_ENV is production). Do not set to true.
# POLL_APPOINTMENTS=false
# POLL_CLIENTS=false

# Never set in production:
# HUBSPOT_WEBHOOK_SKIP_VERIFY
# BLVD_WEBHOOK_SKIP_VERIFY

# Optional overrides (defaults shown). Lifecycle IDs come from the HubSpot ID map.
# BLVD_LIST_CLIENTS_MAX_PAGES=2000
# HUBSPOT_LANGUAGE_PROPERTY=language
# HUBSPOT_BLVD_CLIENT_ID_PROPERTY=blvd_client_id
# HUBSPOT_BLVD_PRE_CUTOVER_CLIENT_PROPERTY=blvd_pre_cutover_client
# HUBSPOT_BACKFILL_LIFECYCLE_VALUE=lead
# HUBSPOT_LOCATION_OBJECT=locations
# HUBSPOT_LOCATION_BLVD_ID_PROPERTY=location_external_id
# HUBSPOT_APPOINTMENT_OBJECT=blvd_appointments
# HUBSPOT_APPOINTMENT_ID_PROPERTY=blvd_appointment_id
# HUBSPOT_APPOINTMENT_ORIGIN_PROPERTY=blvd_appointment_source
# HUBSPOT_APPOINTMENT_SERVICE_OBJECT=blvd_appointment_services
# HUBSPOT_APPOINTMENT_SERVICE_ID_PROPERTY=blvd_appointment_service_id
# HUBSPOT_ORDER_OBJECT=blvd_orders
# HUBSPOT_ORDER_ID_PROPERTY=blvd_order_id
